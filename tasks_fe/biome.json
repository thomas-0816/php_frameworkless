{
    "$schema": "./tests/node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": [
            "**/*.js",
            "**/*.html",
            "**/*.css",
            "!**/dist/**",
            "!**/playwright-report/**",
            "!**/lh_*.html"
        ]
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "off"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "all",
            "suspicious": {
                "noEmptyBlockStatements": "off"
            },
            "correctness": {
                "noUndeclaredDependencies": "off",
                "noNodejsModules": "off"
            }
        }
    },
    "overrides": [
        {
            "includes": ["tests/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    },
                    "style": {
                        "noDefaultExport": "off",
                        "useNamingConvention": "off"
                    }
                }
            }
        }
    ],
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "lineWidth": 120,
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "bracketSpacing": true
        }
    },
    "css": {
        "formatter": {
            "enabled": false
        },
        "linter": {
            "enabled": false
        }
    }
}